{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "allowJs": true,
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"],
    "paths": { "@/*": ["../../apps/token-launchpad/src/*"] }
  },
  "include": [
    "*.ts",
    "../../tests/e2e/seed.ts",
    "../../apps/swap/scripts/seed.ts",
    "../../apps/token-launchpad/scripts/seed.ts"
  ]
}
