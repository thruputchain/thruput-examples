{
  "name": "groundhog-example-apps",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "workspaces": [
    "apps/counter",
    "apps/swap",
    "apps/token-launchpad"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "test": "npm run test --workspaces && vitest run scripts/seed --environment node && node --test tests/e2e/helpers/process-groups.test.mjs",
    "typecheck": "npm run typecheck --workspaces && tsc -p scripts/seed/tsconfig.json",
    "test:wallet": "node tests/e2e/wallet-apps.mjs --build-extension",
    "test:browser": "node tests/browser/apps.mjs",
    "test:counter": "tsx tests/e2e/counter.ts",
    "test:seed": "tsx tests/e2e/seed.ts",
    "test:batching": "tsx --tsconfig apps/swap/tsconfig.json tests/e2e/batching.ts"
  },
  "dependencies": {
    "@groundhogchain/client": "0.14.0",
    "@groundhogchain/protocol": "0.12.0",
    "@groundhogchain/xdr": "0.12.0"
  },
  "devDependencies": {
    "@types/node": "25.9.1",
    "playwright-core": "1.63.0",
    "jsdom": "26.1.0",
    "vite": "7.3.6",
    "tsx": "4.22.4",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
