{
  "name": "groundhog-example-apps",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/swap",
    "apps/token-launchpad"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "test": "npm run test --workspaces && vitest run scripts/demo --environment node",
    "typecheck": "npm run typecheck --workspaces && tsc -p scripts/demo/tsconfig.json",
    "test:wallet": "node scripts/test-wallet-extension.mjs --build-extension",
    "test:browser": "node scripts/test-apps-browser.mjs",
    "test:seed": "tsx scripts/demo/seed-demo.integration.ts"
  },
  "dependencies": {
    "@groundhogchain/client": "file:../groundhog-client-ts",
    "@groundhogchain/protocol": "0.11.0",
    "@groundhogchain/xdr": "0.11.0"
  },
  "devDependencies": {
    "@types/node": "25.9.1",
    "playwright-core": "1.63.0",
    "jsdom": "26.1.0",
    "vite": "7.3.6",
    "tsx": "4.22.4",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
