ignore-scripts=true
save-exact=true
# Cooldown: resolve only releases older than the cooldown period. Recent npm
# releases (such as npm 12) apply this; older ones ignore it.
# First-party @thruputchain packages are exempt. Keep in sync with
# cooldown.toml and .github/dependabot.yml.
min-release-age=8
min-release-age-exclude[]=@thruputchain/*
