{
  "name": "@thruput-examples/airdrop-app",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5177 --strictPort",
    "build": "npm run typecheck && vite build",
    "start": "node --env-file-if-exists=.env.local --import tsx server/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "generate:contracts": "bash scripts/generate-contract-bindings.sh",
    "setup:local": "npm run generate:contracts && tsx scripts/index.ts --network local",
    "setup:devnet": "npm run generate:contracts && tsx scripts/index.ts --network devnet"
  },
  "dependencies": {
    "@fontsource-variable/inconsolata": "5.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "@tanstack/react-query": "5.105.0",
    "@thruputchain/client": "0.25.0",
    "@thruputchain/protocol": "0.19.1",
    "@thruputchain/react": "0.9.0",
    "lucide-react": "1.62.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.3",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
