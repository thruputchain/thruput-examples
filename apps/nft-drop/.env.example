# Setup writes these values. The network ID and factory address are unprefixed
# base58. NFT_CROWD_SEED is private: it derives every simulated user's key.
THRUPUT_RPC_URL=http://127.0.0.1:9545
VITE_THRUPUT_NETWORK_ID=
VITE_NFT_DROP_FACTORY=
NFT_CROWD_SEED=
NFT_CROWD_SIZE=10000
# Production server port (local Vite uses 5178).
PORT=3000
