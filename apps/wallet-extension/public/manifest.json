{
  "manifest_version": 3,
  "name": "Thruput Wallet",
  "version": "0.1.0",
  "minimum_chrome_version": "120",
  "description": "A local-first Groundhog devnet and localnet wallet. Keep your keys, approve every signature.",
  "permissions": ["storage", "alarms", "webNavigation"],
  "host_permissions": ["http://127.0.0.1/*", "https://rpc.thruput.network/*"],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "index.html",
    "default_title": "Thruput Wallet",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": { "service_worker": "worker.js", "type": "module" },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["inpage.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src http://127.0.0.1:9545 https://rpc.thruput.network"
  }
}
