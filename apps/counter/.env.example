# setup:local writes these values for a fresh counter and funded demo account.
VITE_GROUNDHOG_RPC_URL=http://127.0.0.1:9545
VITE_GROUNDHOG_NETWORK_ID=
VITE_COUNTER_ADDRESS=
# Server-only key. setup:local replaces the old, previously public signer.
COUNTER_SIGNING_PRIVATE_KEY=
VITE_EXPLORER_URL=
# Production server port (local Vite uses 5175).
PORT=3000
