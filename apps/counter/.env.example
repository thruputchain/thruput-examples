# Setup writes these values for a fresh counter and funded demo account.
VITE_THRUPUT_RPC_URL=http://127.0.0.1:9545
VITE_THRUPUT_NETWORK_ID=
VITE_COUNTER_ADDRESS=
# Optional server-only development key generated by setup. Omit for wallet-only use.
COUNTER_SIGNING_PRIVATE_KEY=
VITE_EXPLORER_URL=
# Production server port (local Vite uses 5175).
PORT=3000
