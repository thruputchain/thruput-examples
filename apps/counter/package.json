{
  "name": "@thruput-examples/counter-app",
  "version": "0.0.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5175 --strictPort",
    "build": "npm run typecheck && vite build",
    "start": "node --env-file-if-exists=.env.local --import tsx server/main.ts",
    "setup:local": "npm run generate:contracts && tsx scripts/setup-local.ts",
    "setup:devnet": "npm run generate:contracts && tsx scripts/setup-devnet.ts",
    "generate:contracts": "bash scripts/generate-contract-bindings.sh",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource-variable/inconsolata": "5.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "@tanstack/react-query": "5.105.0",
    "@thruputchain/client": "0.25.0",
    "@thruputchain/contract-spec": "0.19.1",
    "@thruputchain/protocol": "0.19.1",
    "@thruputchain/react": "0.9.0",
    "@thruputchain/xdr": "0.19.1",
    "lucide-react": "1.62.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sonner": "2.0.8",
    "tsx": "4.23.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
