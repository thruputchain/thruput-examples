{
  "name": "@thruput-examples/voting-app",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5176 --strictPort",
    "build": "npm run typecheck && vite build",
    "start": "vite preview --host 127.0.0.1 --port 5176 --strictPort",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "generate:contracts": "bash scripts/generate-contract-bindings.sh",
    "setup:local": "npm run generate:contracts && tsx scripts/setup-local.ts",
    "test:local": "tsx scripts/test-local.ts",
    "test:browser": "tsx scripts/test-browser.ts"
  },
  "dependencies": {
    "@fontsource-variable/inconsolata": "5.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "@tanstack/react-query": "5.103.1",
    "@thruputchain/client": "0.24.0",
    "@thruputchain/contract-spec": "0.19.0",
    "@thruputchain/protocol": "0.19.0",
    "@thruputchain/react": "0.8.0",
    "@thruputchain/xdr": "0.19.0",
    "lucide-react": "0.468.0",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "react-router-dom": "7.18.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.11",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "25.9.1",
    "@types/react": "19.1.9",
    "@types/react-dom": "19.1.7",
    "@vitejs/plugin-react": "5.0.0",
    "jsdom": "26.1.0",
    "prettier": "3.9.6",
    "tailwindcss": "4.1.11",
    "tsx": "4.22.4",
    "typescript": "6.0.3",
    "vite": "7.3.6",
    "vitest": "4.1.11"
  }
}
