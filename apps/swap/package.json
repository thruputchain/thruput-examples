{
  "name": "@groundhog-examples/swap-app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "generate:contracts": "bash scripts/generate-contract-bindings.sh",
    "preview": "vite preview",
    "setup:local": "bash scripts/setup-local.sh",
    "test": "vitest run",
    "test:components": "vitest run src/app.test.tsx",
    "test:e2e:local": "RUN_CLEAN_LEDGER_E2E=1 bash scripts/test-clean-ledger.sh",
    "test:integration:local": "vitest run --mode local-integration src/integration/*.local.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json"
  },
  "dependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "@groundhogchain/client": "0.4.0",
    "@groundhogchain/contract-spec": "0.8.0",
    "@groundhogchain/protocol": "0.8.0",
    "@groundhogchain/xdr": "0.8.0",
    "@noble/hashes": "2.2.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "0.468.0",
    "radix-ui": "1.6.7",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "react-router-dom": "7.8.2",
    "shadcn": "4.16.1",
    "smol-toml": "1.8.0",
    "tailwind-merge": "3.3.1",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.11",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "25.9.1",
    "@types/react": "19.1.9",
    "@types/react-dom": "19.1.7",
    "@vitejs/plugin-react": "5.0.0",
    "jsdom": "26.1.0",
    "prettier": "3.9.6",
    "tailwindcss": "4.1.11",
    "tsx": "4.22.4",
    "typescript": "6.0.3",
    "vite": "7.3.6",
    "vitest": "4.1.8"
  }
}
