{
  "name": "@thruput-examples/swap-app",
  "version": "0.0.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "npm run typecheck && vite build",
    "dev": "vite --host 127.0.0.1 --port 5174 --strictPort",
    "generate:contracts": "bash scripts/generate-contract-bindings.sh",
    "setup:local": "npm run generate:contracts && tsx scripts/setup-local.ts",
    "setup:devnet": "npm run generate:contracts && tsx scripts/setup-devnet.ts",
    "seed": "tsx scripts/seed.ts",
    "start": "node --env-file-if-exists=.env.local --import tsx server/main.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@groundhogchain/client": "0.17.0",
    "@groundhogchain/contract-spec": "0.13.0",
    "@groundhogchain/protocol": "0.13.0",
    "@groundhogchain/react": "0.4.0",
    "@groundhogchain/xdr": "0.13.0",
    "@tanstack/react-query": "5.103.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "lucide-react": "0.468.0",
    "radix-ui": "1.6.7",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "react-router-dom": "7.18.3",
    "tailwind-merge": "3.3.1",
    "tsx": "4.22.4",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.11",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "25.9.1",
    "@types/react": "19.1.9",
    "@types/react-dom": "19.1.7",
    "@vitejs/plugin-react": "5.0.0",
    "jsdom": "26.1.0",
    "prettier": "3.9.6",
    "tailwindcss": "4.1.11",
    "typescript": "6.0.3",
    "vite": "7.3.6",
    "vitest": "4.1.11"
  }
}
