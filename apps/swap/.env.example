# Server runtime configuration. Replace every example value.
# Optional build-time APP_BASE_PATH=/swap/ behind the examples gateway.
# Network IDs, addresses, and code hashes are unprefixed base58.
# Optional root explorer URL. Blank disables links; remote hosts require HTTPS.
VITE_EXPLORER_URL=
VITE_THRUPUT_RPC_URL=https://rpc.example.com
VITE_THRUPUT_NETWORK_ID=11111111111111111111111111111111
VITE_NATIVE_TOKEN_ADDRESS=11111111111111111111111111111111
# Setup publishes public/contract-artifacts/${VITE_POOL_TOKEN_HASH}.json.
VITE_POOL_TOKEN_HASH=11111111111111111111111111111111
VITE_SWAP_FACTORY_ADDRESS=11111111111111111111111111111111
VITE_SWAP_ROUTER_ADDRESS=11111111111111111111111111111111

# Optional indexed token suggestions; independent of the pool registry.
# Use the launchpad's factory/hash and this app's existing network ID.
VITE_TOKEN_DISCOVERY_ENABLED=false
VITE_STANDARD_TOKEN_FACTORY_ADDRESS=
VITE_STANDARD_TOKEN_HASH=
# Server-only HTTPS root origin (or exact loopback HTTP); required when enabled.
# On Railway, http://token-launchpad.railway.internal:3000 is also supported.
TOKEN_DISCOVERY_UPSTREAM_ORIGIN=
# Restart the server and reload the page after changing public settings.
# Connect Thruput Freighter to enable writes in development or production.
# Discovery uses the launchpad origin: its dev server also serves the registry.

PORT=3000
POOL_REGISTRY_DB_PATH=/data/pools.sqlite
POOL_REGISTRY_SYNC_INTERVAL_MS=5000
POOL_REGISTRY_PAGE_SIZE=200
