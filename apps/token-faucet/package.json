{
  "name": "@groundhog-examples/token-faucet-app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5175 --strictPort",
    "build": "npm run typecheck && vite build",
    "start": "node --env-file-if-exists=.env.local --import tsx server/main.ts",
    "setup:devnet": "tsx scripts/setup-devnet.ts",
    "test": "vitest run",
    "test:devnet": "tsx scripts/verify-devnet.ts",
    "test:browser": "tsx scripts/verify-browser.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@groundhogchain/client": "0.8.0",
    "@groundhogchain/protocol": "0.11.0",
    "@groundhogchain/xdr": "0.11.0",
    "lucide-react": "0.468.0",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "tsx": "4.22.4"
  },
  "devDependencies": {
    "@types/node": "25.9.1",
    "@types/react": "19.1.9",
    "@types/react-dom": "19.1.7",
    "@vitejs/plugin-react": "5.0.0",
    "typescript": "6.0.3",
    "vite": "7.3.6",
    "vitest": "4.1.11"
  }
}
